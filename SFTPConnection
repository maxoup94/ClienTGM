    public static void Delete(final String remoteFilePath, final Context context) {
        Log.d("TAAG", "deleteFile " + remoteFilePath);
        ExecutorService executor = Executors.newSingleThreadExecutor();
        Handler handler = new Handler(Looper.getMainLooper());
        final boolean[] status = {false};
        handler.post(new Runnable() {
            @Override
            public void run() {
                progress.setVisibility(View.VISIBLE);
                progressText.setText("Deleting...");
            }
        });

        executor.execute(new Runnable() {
            @Override
            public void run() {
                try {
                    initSession(context);
                    // Check if the path is a file or directory
                    SftpATTRS attrs = sftpChannel.stat(remoteFilePath);
                    if (attrs.isDir()) {
                        deleteDirectory(sftpChannel, remoteFilePath);
                        status[0] = true;
                    } else if (attrs.isReg()) {
                        sftpChannel.rm(remoteFilePath);
                        status[0] = true;
                    } else {
                        System.out.println(remoteFilePath + " is neither a regular file nor a directory.");
                    }


                } catch (Exception e) {
                    Log.e("TAAG", "SFTPDelete Failed to delete: " + e.getMessage());

                } finally {
                    closeSession();
                }
                ListFiles(context);
                handler.post(new Runnable() {
                    @Override
                    public void run() {
                        progress.setVisibility(View.GONE);
                        progressText.setText("");
                        if (status[0]) {
                            Log.d("TAAG", "SFTPDelete File deletion completed");
                        } else {
                            classUtils.messageDialog("ALERT", "Deleting Error " + remoteFilePath, context);
                        }

                    }
                });
            }
        });
    }


    public static void deleteDirectory(ChannelSftp sftpChannel, String path) throws SftpException {
        Vector<ChannelSftp.LsEntry> list = sftpChannel.ls(path);

        for (ChannelSftp.LsEntry entry : list) {
            String fileName = entry.getFilename();
            if (".".equals(fileName) || "..".equals(fileName)) {
                continue;
            }
            String fullPath = path + "/" + fileName;

            if (entry.getAttrs().isDir()) {
                // Recursively delete subdirectory
                deleteDirectory(sftpChannel, fullPath);
            } else {
                // Delete file
                sftpChannel.rm(fullPath);
            }
        }

        // Delete the directory itself
        sftpChannel.rmdir(path);
    }

