    private void searchFilesRecursive(ChannelSftp sftpChannel, String remoteDir, String searchText, Context context) throws SftpException {
        Log.d("TAAG", "SFTP searchFilesRecursive " + remoteDir);
        Vector<ChannelSftp.LsEntry> files = sftpChannel.ls(remoteDir);
        for (ChannelSftp.LsEntry entry : files) {
            String fileName = entry.getFilename();
            if (fileName.equals(".") || fileName.equals("..")) continue;
            String filePath = remoteDir + "/" + fileName;
            if (entry.getAttrs().isDir()) {
                searchFilesRecursive(sftpChannel, filePath, searchText, context);
            } else {
                if (fileName.toLowerCase().contains(searchText.toLowerCase())) {
                    long fileSize = entry.getAttrs().getSize();
                    String type = "sftpfile";
                    long lastModified = entry.getAttrs().getMTime() * 1000L;
                    String comment = "";
                    FileExplorerM.FileInfo fileInfo = new FileExplorerM.FileInfo(fileName, comment, lastModified, fileSize, filePath, type);
                    fileInfoList.add(fileInfo);
                }
            }
        }
    }

