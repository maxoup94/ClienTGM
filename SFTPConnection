    public static String ReadFile(String filePath, Context context) {
        ExecutorService executor = Executors.newSingleThreadExecutor();

        Log.d("TAAG", "ReadFile " + filePath);

        Future<String> future = executor.submit(new Callable<String>() {
            @Override
            public String call() {
                ByteArrayOutputStream outputStream = new ByteArrayOutputStream();
                try {
                    initSession(context);
                    sftpChannel.get(filePath, outputStream);
                    return outputStream.toString();
                } catch (Exception e) {
                    Log.e("TAAG", "ReadFile Failed: " + e.getMessage());
                    return null;
                } finally {
                    closeSession();
                }
            }
        });

        try {
            return future.get();
        } catch (InterruptedException | ExecutionException e) {
            Log.e("TAAG", "ReadFile execution failed: " + e.getMessage());
            return null;
        } finally {
            executor.shutdown();
        }
    }


