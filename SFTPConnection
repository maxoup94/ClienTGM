    public static void ListFiles(final Context context) {
        String remoteDir = cheminCourant;
        if (remoteDir.startsWith("sftp")) {
            remoteDir = remoteDir.split(":")[1];
        }
        Log.d("TAAG", "SFTP listFiles " + remoteDir);
        ExecutorService executor = Executors.newSingleThreadExecutor();
        // Handler handler = new Handler(Looper.getMainLooper());
        handler.post(new Runnable() {
            @Override
            public void run() {
                progress.setVisibility(View.VISIBLE);
            }
        });
        String finalRemoteDir = remoteDir;
        executor.execute(new Runnable() {
            @Override
            public void run() {
                //  ArrayList<FileExplorerM.FileInfo> fileList = new ArrayList<>();
                try {
                    initSession(context);
                    Vector<ChannelSftp.LsEntry> files = sftpChannel.ls(finalRemoteDir);

                    fileInfoList.clear();
                    for (ChannelSftp.LsEntry entry : files) {
                        String fileName = entry.getFilename();
                        if (fileName.equals(".") || fileName.equals("..")) continue;
                        if (hideFile && fileName.startsWith(".")) continue;

                        long fileSize;
                        String filePath = finalRemoteDir + "/" + fileName;

                        String type;
                        if (entry.getAttrs().isDir()) {
                            fileSize = -1;
                            type = "sftpdir";
                        } else {
                            fileSize = entry.getAttrs().getSize();
                            type = "sftpfile";
                        }

                        long lastModified = entry.getAttrs().getMTime() * 1000L; // Conversion en millisecondes
                        String comment = "";
                        FileExplorerM.FileInfo fileInfo = new FileExplorerM.FileInfo(fileName, comment, lastModified, fileSize, filePath, type);
                        fileInfoList.add(fileInfo);
                    }
                } catch (Exception e) {
                    Log.e("TAAG", "SFTPlistfiles Failed to list files: " + e.getMessage());
                    e.printStackTrace();
                } finally {
                    closeSession();
                }

                handler.post(new Runnable() {
                    @Override
                    public void run() {
                        sortFileInfo();
                        progress.setVisibility(View.GONE);
                        pathTextView.setText(cheminCourant);
                        adapter.notifyDataSetChanged();

                        Log.d("TAAG", "SFTPlistfiles File listing completed");

                        // callback.onListFilesComplete(fileList);
                    }
                });
            }
        });
    }

    static void OpenFile(String remoteFilePath, Context context) {
        Log.d("TAAG", "openFile() " + remoteFilePath);
        if (remoteFilePath.endsWith(".txt")) {
            String text = ReadFile(remoteFilePath, context);
            actionCreateText(text, getPathName(remoteFilePath), context);
            return;
        }
        ExecutorService executor = Executors.newSingleThreadExecutor();
        handler.post(new Runnable() {
            @Override
            public void run() {
                progress.setVisibility(View.VISIBLE);
                progressText.setText("0%");
            }
        });
        String localFilePath = context.getExternalCacheDir() + "/tmp~" + new File(remoteFilePath).getName();
        Log.d("TAAG", "openFile() " + localFilePath);

        final boolean[] status = {false};
        executor.execute(new Runnable() {
            @Override
            public void run() {
                try {
                    initSession(context);
                    long fileSize = sftpChannel.lstat(remoteFilePath).getSize();
                    InputStream inputStream = sftpChannel.get(remoteFilePath);
                    FileOutputStream fos = new FileOutputStream(localFilePath);
                    byte[] buffer = new byte[4096];
                    int bytesRead;
                    long totalBytesRead = 0;

                    while ((bytesRead = inputStream.read(buffer)) != -1) {
                        fos.write(buffer, 0, bytesRead);
                        totalBytesRead += bytesRead;
                        final int progress = (int) ((totalBytesRead * 100) / fileSize);

                        handler.post(new Runnable() {
                            @Override
                            public void run() {
                                progressText.setText(progress + "%");
                            }
                        });
                    }

                    fos.close();
                    inputStream.close();
                    status[0] = true;
                } catch (Exception e) {
                    Log.e("TAAG", "SFTPDownload Failed to download: " + e.getMessage());
                } finally {
                    closeSession();
                }

                handler.post(new Runnable() {
                    @Override
                    public void run() {
                        progress.setVisibility(View.GONE);
                        progressText.setText("");
                        Log.d("TAAG", "SFTPDownload Download completed");
                        if (status[0]) {
                            File file = new File(localFilePath);

                            tmpFileName = file;
                            Context applicationContext = context.getApplicationContext();
                            Uri contentUri = FileProvider.getUriForFile(applicationContext.getApplicationContext(), applicationContext.getPackageName() + ".fileprovider", file);
                            Intent intent = new Intent(Intent.ACTION_VIEW);
                            intent.setData(contentUri);
                            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
                            intent.putExtra("filePath", localFilePath);
                            if (intent.resolveActivity(applicationContext.getPackageManager()) != null) {
                                openFileLauncher.launch(intent);
                            }

                        }
                    }
                });
            }
        });

    }

