    public void Command(final Context context, final String command) {
        Log.d("TAAG", "executeCommand: " + command + " on host: " + host);
        ExecutorService executor = Executors.newSingleThreadExecutor();
        // Handler handler = new Handler(Looper.getMainLooper());

        handler.post(new Runnable() {
            @Override
            public void run() {
                progress.setVisibility(View.VISIBLE);
                progressText.setText("Executing command...");
            }
        });

        executor.execute(new Runnable() {
            @Override
            public void run() {
                JSch jsch = new JSch();
                Session session = null;
                ChannelExec channelExec = null;

                try {
                    session = jsch.getSession(user, host, 22);
                    session.setPassword(password);
                    session.setConfig("StrictHostKeyChecking", "no");
                    session.connect();

                    channelExec = (ChannelExec) session.openChannel("exec");
                    channelExec.setCommand(command);
                    channelExec.setErrStream(System.err);

                    InputStream in = channelExec.getInputStream();
                    channelExec.connect();

                    BufferedReader reader = new BufferedReader(new InputStreamReader(in));
                    String line;
                    while ((line = reader.readLine()) != null) {
                        Log.d("TAAG", "Output: " + line);
                    }
                    reader.close();

                } catch (Exception e) {
                    Log.e("TAAG", "SFTPCommandExecutor Failed to execute command: " + e.getMessage());
                    e.printStackTrace();
                } finally {
                    if (channelExec != null) {
                        channelExec.disconnect();
                    }
                    if (session != null) {
                        session.disconnect();
                    }
                }

                handler.post(new Runnable() {
                    @Override
                    public void run() {
                        progress.setVisibility(View.GONE);
                        progressText.setText("");
                        Log.d("TAAG", "SFTPCommandExecutor Command execution completed");
                        //callback.onCommandComplete();
                    }
                });
            }
        });
    }


